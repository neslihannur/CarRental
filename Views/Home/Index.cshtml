@model HomeViewModel
@{
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var days = Model.ReturnDate.DayNumber - Model.PickupDate.DayNumber;
    var reservationCode = TempData["ReservationCode"] as string;
    var reservationError = TempData["ReservationError"] as string;
}

<section id="hero" class="position-relative overflow-hidden">
    <div class="pattern-overlay pattern-left position-absolute">
        <img src="~/images/hero-pattern-left.png" alt="">
    </div>
    <div class="container hero-grid">
        <div class="hero-text" data-aos="fade-up">
            <span class="eyebrow"><iconify-icon icon="solar:star-bold"></iconify-icon> 4,9 / 5 · 12.000+ mutlu sürücü</span>
            <h1>Yola çıkmanın <span class="text-primary">en kolay</span> yolu.</h1>
            <p class="hero-paragraph">
                Sedan'dan arazi aracına geniş filomuzdan aracınızı seçin, dakikalar içinde rezervasyonunuzu yapın.
                Havalimanında ya da kapınızda teslim.
            </p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a href="#filo" class="btn btn-primary btn-lg-pill">Filoyu Keşfet</a>
                <a href="#process" class="btn btn-ghost btn-lg-pill">Nasıl çalışır?</a>
            </div>
            <ul class="hero-stats list-unstyled">
                <li><strong>@Fleet.Cars.Count</strong><span>premium model</span></li>
                <li><strong>7</strong><span>teslim noktası</span></li>
                <li><strong>7/24</strong><span>yol yardımı</span></li>
            </ul>
        </div>
        <div class="hero-visual" data-aos="fade-up" data-aos-delay="150">
            <img src="~/images/banner-img.jpg" alt="Mercedes-AMG GT" fetchpriority="high">
            <div class="hero-badge">
                <iconify-icon icon="solar:shield-check-bold"></iconify-icon>
                <div><strong>Tam kasko dahil</strong><span>Sürpriz ücret yok</span></div>
            </div>
        </div>
    </div>
</section>

<section id="search">
    <div class="container">
        <form class="search-card row g-3 align-items-end" method="get" action="/#filo" data-aos="fade-up">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="tip" class="form-label">Araç tipi</label>
                <div class="field-icon">
                    <iconify-icon icon="solar:wheel-outline"></iconify-icon>
                    <select class="form-select" id="tip" name="tip">
                        <option value="">Tüm araçlar</option>
                        @foreach (var c in Fleet.Categories)
                        {
                            <option value="@c" selected="@(c == Model.Category)">@c</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="konum" class="form-label">Alış noktası</label>
                <div class="field-icon">
                    <iconify-icon icon="solar:map-point-outline"></iconify-icon>
                    <select class="form-select" id="konum" name="konum">
                        @foreach (var l in Fleet.Locations)
                        {
                            <option selected="@(l == Model.Location)">@l</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <label for="alis" class="form-label">Alış tarihi</label>
                <input type="date" class="form-control" id="alis" name="alis" value="@Model.PickupDate.ToString("yyyy-MM-dd")" data-min-today>
            </div>
            <div class="col-6 col-lg-2">
                <label for="donus" class="form-label">Dönüş tarihi</label>
                <input type="date" class="form-control" id="donus" name="donus" value="@Model.ReturnDate.ToString("yyyy-MM-dd")" data-min-today>
            </div>
            <div class="col-12 col-lg-2 d-grid">
                <button class="btn btn-primary btn-search" type="submit">
                    <iconify-icon icon="solar:magnifer-linear"></iconify-icon> Araç Bul
                </button>
            </div>
        </form>
    </div>
</section>

@if (reservationCode is not null)
{
    <section id="rezervasyon" class="container">
        <div class="reservation-success" data-aos="zoom-in">
            <iconify-icon icon="solar:check-circle-bold" class="success-icon"></iconify-icon>
            <div>
                <h3>Rezervasyonunuz alındı, @TempData["ReservationName"]!</h3>
                <p class="mb-1"><strong>@TempData["ReservationCar"]</strong> · @TempData["ReservationSummary"]</p>
                <p class="mb-0">Toplam tutar <strong>@TempData["ReservationTotal"]</strong> · Rezervasyon kodu <span class="code">@reservationCode</span></p>
            </div>
        </div>
    </section>
}

<section id="filo" class="section">
    <div class="container">
        <div class="section-head" data-aos="fade-up">
            <div>
                <span class="eyebrow">Filomuz</span>
                <h2>Her yolculuğa <span class="text-primary">uygun araç</span></h2>
            </div>
            <p>
                @if (Model.Filtered)
                {
                    <text><strong>@Model.Cars.Count araç</strong> bulundu · @Model.PickupDate.ToString("d MMMM", tr) – @Model.ReturnDate.ToString("d MMMM", tr), @days gün</text>
                }
                else
                {
                    <text>Fiyatlara kasko, sınırsız kilometre ve KDV dahildir.</text>
                }
            </p>
        </div>

        <div class="category-pills" data-aos="fade-up">
            <a href="/?#filo" class="@(Model.Category is null ? "active" : "")">Tümü</a>
            @foreach (var c in Fleet.Categories)
            {
                <a href="/?tip=@c#filo" class="@(c == Model.Category ? "active" : "")">@c</a>
            }
        </div>

        @if (reservationError is not null)
        {
            <div class="alert alert-warning mt-4">@reservationError</div>
        }

        <div class="row g-4 mt-1">
            @foreach (var car in Model.Cars)
            {
                <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up">
                    <article class="car-card">
                        <div class="car-media">
                            <img src="~/images/@car.Image" alt="@car.Brand @car.Model" loading="lazy">
                            <span class="car-tag">@car.Category</span>
                        </div>
                        <div class="car-body">
                            <p class="car-brand">@car.Brand · @car.Year</p>
                            <h4>@car.Model</h4>
                            <p class="car-tagline">@car.Tagline</p>
                            <ul class="car-specs list-unstyled">
                                <li><iconify-icon icon="solar:users-group-rounded-outline"></iconify-icon> @car.Seats kişi</li>
                                <li><iconify-icon icon="solar:settings-outline"></iconify-icon> @car.Transmission</li>
                                <li><iconify-icon icon="solar:gas-station-outline"></iconify-icon> @car.Fuel</li>
                            </ul>
                            <div class="car-foot">
                                <div class="car-price">
                                    <strong>@car.DailyPrice.ToString("N0", tr) ₺</strong><span>/ gün</span>
                                </div>
                                <button type="button" class="btn btn-primary btn-rent"
                                        data-bs-toggle="modal" data-bs-target="#reserveModal"
                                        data-car-id="@car.Id" data-car-name="@car.Brand @car.Model"
                                        data-car-price="@car.DailyPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-car-image="@Url.Content("~/images/" + car.Image)">
                                    Kirala
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        @if (Model.Cars.Count == 0)
        {
            <p class="text-center mt-5">Bu tipte araç kalmadı. <a href="/#filo">Tüm araçlara göz atın.</a></p>
        }
    </div>
</section>

<section id="process" class="section section-soft">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="eyebrow">Nasıl çalışır</span>
            <h2>Dört adımda <span class="text-primary">yoldasınız</span></h2>
        </div>
        <div class="row g-4 mt-4">
            @{
                var steps = new[]
                {
                    ("solar:wheel-outline", "Aracınızı seçin", "Filodan ihtiyacınıza uygun aracı tip ve tarihe göre filtreleyin."),
                    ("solar:calendar-mark-outline", "Tarih ve yer", "Havalimanı, ofis ya da adresinize teslim noktasını belirleyin."),
                    ("solar:document-add-outline", "Rezervasyon", "Bilgilerinizi girin, toplam tutarı anında görün; ön ödeme yok."),
                    ("solar:key-minimalistic-outline", "Anahtar teslim", "Ehliyetinizi gösterin, aracınızı teslim alın ve yola çıkın."),
                };
            }
            @for (var i = 0; i < steps.Length; i++)
            {
                var (icon, title, text) = steps[i];
                <div class="col-6 col-lg-3" data-aos="fade-up" data-aos-delay="@(i * 100)">
                    <div class="step">
                        <span class="step-no">0@(i + 1)</span>
                        <iconify-icon icon="@icon" class="step-icon"></iconify-icon>
                        <h5>@title</h5>
                        <p>@text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="testimonial" class="position-relative">
    <div class="pattern-overlay pattern-left position-absolute">
        <img src="~/images/testimonial-pattern.png" alt="">
    </div>
    <div class="container py-5 my-5">
        <div class="swiper testimonial-swiper">
            <div class="swiper-wrapper">
                @foreach (var (quote, name, img) in new[]
                {
                    ("Gece yarısı indiğimiz halde araç kapıdaydı. Teslim beş dakika sürdü, araç tertemizdi.", "Elif K. · Sabiha Gökçen", "commentor-item1.jpg"),
                    ("Defender ile Kaçkarlar'a çıktık; yol yardımı bir telefon kadar yakındı. Kesinlikle tekrar.", "Mert A. · Trabzon rotası", "commentor-item2.jpg"),
                    ("Fiyat ne gösterildiyse o çıktı. Kiralamadan önce toplam tutarı görmek büyük rahatlık.", "Zeynep D. · İzmir", "commentor-item3.jpg"),
                })
                {
                    <div class="swiper-slide text-center">
                        <div class="offset-md-2 col-md-8">
                            <iconify-icon icon="mdi:format-quote-open" class="testimonial-icon"></iconify-icon>
                            <p class="testimonial-paragraph">@quote</p>
                            <div class="d-flex align-items-center justify-content-center gap-3 mt-3">
                                <img src="~/images/@img" alt="" class="avatar">
                                <h5 class="mb-0">@name</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="swiper-pagination position-unset mt-4"></div>
        </div>
    </div>
</section>

<section id="pricing" class="section">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="eyebrow">Uzun dönem kiralama</span>
            <h2>Şirketiniz ve siz için <span class="text-primary">paketler</span></h2>
        </div>
        <div class="d-flex justify-content-center mt-4">
            <label class="pt-2" id="monthly-label">Aylık</label>
            <span class="form-check form-switch p-0">
                <input class="form-check-input mx-2" type="checkbox" role="switch" id="flexSwitchCheckChecked" checked>
                <label class="pt-2" id="yearly-label" for="flexSwitchCheckChecked">Yıllık <small class="save-badge">%15 tasarruf</small></label>
            </span>
        </div>
        <div class="row py-4 g-4">
            <div class="col-lg-3 col-sm-6 col-12">
                <div class="pricing-lable pt-5 h-100">
                    <div class="pt-3 ps-2">
                        <h3>Uzun dönemde daha az ödeyin</h3>
                        <p>Bakım, sigorta ve lastik değişimi pakete dahil. Siz sadece sürün.</p>
                    </div>
                    <iconify-icon class="pricing-lable-icon" icon="fluent:vehicle-car-profile-ltr-20-regular"></iconify-icon>
                </div>
            </div>
            @foreach (var (name, monthly, features, featured) in new[]
            {
                ("Bireysel", 28_900m, new[] { "Kompakt sedan", "Aylık 2.500 km", "Kasko ve trafik sigortası", "Periyodik bakım" }, false),
                ("Kurumsal", 41_500m, new[] { "Premium sedan veya SUV", "Aylık 4.000 km", "Kasko ve trafik sigortası", "Periyodik bakım", "İkame araç" }, true),
                ("Filo", 36_900m, new[] { "5+ araç, araç başı fiyat", "Sınırsız kilometre", "Kasko ve trafik sigortası", "Bakım ve lastik", "İkame araç", "Filo yöneticisi" }, false),
            })
            {
                <div class="col-lg-3 col-sm-6 col-12">
                    <div class="pricing-detail py-5 text-center h-100 @(featured ? "featured" : "")">
                        <div class="pricing-content">
                            <h5 class="@(featured ? "price-recommend" : "")">@name</h5>
                            <div class="content monthly pt-2">
                                <h3>@monthly.ToString("N0", tr) ₺</h3><small>/ ay</small>
                            </div>
                            <div class="content yearly pt-2">
                                <h3>@((monthly * 12 * 0.85m).ToString("N0", tr)) ₺</h3><small>/ yıl</small>
                            </div>
                            <div class="pt-4">
                                @foreach (var f in features)
                                {
                                    <p>✓ @f</p>
                                }
                            </div>
                        </div>
                        <div class="pricing-button">
                            <a href="#action" class="btn btn-primary @(featured ? "active" : "")">Teklif Al</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="services" class="section section-soft">
    <div class="container">
        <div class="row align-items-end">
            <div class="col-lg-6" data-aos="fade-up">
                <span class="eyebrow">Neden GoCar</span>
                <h2>Kiralamanın <span class="text-primary">zahmetsiz</span> hali</h2>
            </div>
            <div class="col-lg-6" data-aos="fade-up">
                <p class="mt-3 mt-lg-0">
                    Kiralama sürecindeki küçük sürprizleri ortadan kaldırmak için çalışıyoruz: net fiyat, temiz araç,
                    zamanında teslim ve yolda kaldığınızda ulaşabileceğiniz bir ekip.
                </p>
            </div>
        </div>
        <div class="row g-4 mt-4">
            @foreach (var (icon, title, text) in new[]
            {
                ("solar:shield-check-outline", "Güvenli ödeme", "3D Secure ile ödeme; depozito teslimde iade edilir."),
                ("solar:wheel-angle-outline", "Her sınıftan araç", "Sedan, SUV, spor ve arazi araçları tek filoda."),
                ("solar:plain-2-outline", "Havalimanı teslimi", "Uçuşunuzu takip eder, gecikmede bekleriz."),
                ("solar:call-chat-outline", "7/24 destek", "Yol yardımı ve müşteri hizmetleri her an yanınızda."),
            })
            {
                <div class="col-6 col-lg-3" data-aos="fade-up">
                    <div class="services-components text-center pt-4 pb-3 h-100">
                        <iconify-icon class="services-icon my-2" icon="@icon"></iconify-icon>
                        <h5>@title</h5>
                        <p>@text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="faq" class="section">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <span class="eyebrow">SSS</span>
            <h2>Aklınıza takılanlar</h2>
        </div>
        <div class="accordion col-md-8 offset-md-2 mt-4" id="faqAccordion">
            @{
                var faqs = new[]
                {
                    ("Araç kiralamak için hangi belgeler gerekiyor?", "Geçerli bir sürücü belgesi (en az 2 yıllık), kimlik ya da pasaport ve sürücü adına bir kredi kartı yeterli. Spor ve arazi sınıfında ehliyet yaşı en az 5 yıl olmalı."),
                    ("Fiyatlara neler dahil?", "Kasko, zorunlu trafik sigortası, KDV ve sınırsız kilometre günlük fiyata dahildir. Yakıt, köprü ve otoyol geçişleri kullanıma göre ayrıca hesaplanır."),
                    ("Rezervasyonu iptal edebilir miyim?", "Alış saatinden 24 saat öncesine kadar ücretsiz iptal edebilirsiniz. Daha geç iptallerde bir günlük kira bedeli alınır."),
                    ("Aracı farklı bir noktada bırakabilir miyim?", "Evet. Teslim noktalarımızdan herhangi birine bırakabilirsiniz; şehirler arası bırakmalarda mesafeye göre ek ücret uygulanır."),
                };
            }
            @for (var i = 0; i < faqs.Length; i++)
            {
                var (q, a) = faqs[i];
                <div class="accordion-item mt-3">
                    <h5 class="accordion-header">
                        <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse"
                                data-bs-target="#faq@(i)" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="faq@(i)">
                            @q
                        </button>
                    </h5>
                    <div id="faq@(i)" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#faqAccordion">
                        <div class="accordion-body"><p>@a</p></div>
                    </div>
                </div>
                <hr>
            }
        </div>
    </div>
</section>

<section id="action" class="position-relative">
    <div class="container">
        <div class="cta-card" data-aos="fade-up">
            <div class="pattern-overlay pattern-right position-absolute">
                <img src="~/images/call-to-action-pattern.png" alt="">
            </div>
            <div class="row align-items-center position-relative">
                <div class="col-lg-7">
                    <h2>Yolculuğunuz bir <span class="text-primary">tık uzakta.</span></h2>
                    <p>Kurumsal teklif, uzun dönem kiralama ya da özel istekleriniz için ekibimiz 7/24 ulaşılabilir.</p>
                </div>
                <div class="col-lg-5 d-flex flex-wrap gap-3 justify-content-lg-end">
                    <a href="#filo" class="btn btn-primary btn-lg-pill">Araç Seç</a>
                    <a href="tel:08500000000" class="btn btn-light btn-lg-pill"><iconify-icon icon="solar:phone-outline"></iconify-icon> 0850 000 00 00</a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="reserveModal" tabindex="-1" aria-labelledby="reserveTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form method="post" action="/rezervasyon">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CarId" id="r-car-id">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <img id="r-car-image" src="" alt="" class="modal-car">
                        <div>
                            <p class="car-brand mb-0">Rezervasyon</p>
                            <h4 class="modal-title" id="reserveTitle">Araç</h4>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="r-location">Alış noktası</label>
                            <select class="form-select" id="r-location" name="PickupLocation" required>
                                @foreach (var l in Fleet.Locations)
                                {
                                    <option selected="@(l == Model.Location)">@l</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="r-pickup">Alış</label>
                            <input type="date" class="form-control" id="r-pickup" name="PickupDate" value="@Model.PickupDate.ToString("yyyy-MM-dd")" required data-min-today>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" for="r-return">Dönüş</label>
                            <input type="date" class="form-control" id="r-return" name="ReturnDate" value="@Model.ReturnDate.ToString("yyyy-MM-dd")" required data-min-today>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="r-name">Ad soyad</label>
                            <input class="form-control" id="r-name" name="FullName" required maxlength="80" autocomplete="name">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="r-phone">Telefon</label>
                            <input class="form-control" id="r-phone" name="Phone" type="tel" required maxlength="20" autocomplete="tel" placeholder="05xx xxx xx xx">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="r-email">E-posta</label>
                            <input class="form-control" id="r-email" name="Email" type="email" required maxlength="120" autocomplete="email">
                        </div>
                        <input name="Website" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true">
                    </div>
                    <div class="price-summary mt-4">
                        <span id="r-days">—</span>
                        <strong id="r-total">—</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <small class="text-muted me-auto">Demo projedir, ödeme alınmaz.</small>
                    <button type="submit" class="btn btn-primary">Rezervasyonu Tamamla</button>
                </div>
            </form>
        </div>
    </div>
</div>
