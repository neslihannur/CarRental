@model HomePage
@{
    ViewData["DarkHeader"] = true;
    ViewData["Trip"] = Model.Trip;
    var testimonials = new (string Name, string Meta, string Text, string? Img)[]
    {
        ("Elif K.", "Ferrari 458 · İstanbul", "Evlilik yıldönümümüz için kiraladık. Araç kapıda tertemiz ve dolu depoyla bekliyordu; teslim 10 dakika sürdü.", "commentor-item1.jpg"),
        ("Burak A.", "BMW 520i · Ankara", "İş seyahatlerimde artık tek adresim. Uçuşum rötar yaptı, ekip gece yarısı beni bekledi.", "commentor-item2.jpg"),
        ("Zeynep D.", "Defender 110 · Antalya", "Kamp tatili için Defender aldık. Tavan rafı, çeki demiri… her şey hazırdı. Fiyat da sürpriz değildi.", "commentor-item3.jpg"),
        ("Mert Y.", "AMG GT R · İzmir", "Rezervasyon iki dakika sürdü, onay maili ve takvim daveti anında geldi. Böyle olmalı.", null),
        ("Selin Ö.", "Ford Expedition · İstanbul", "6 kişilik aile + 5 bavul. Havalimanında karşılandık, çocuk koltuğu takılıydı.", null),
        ("Kerem Ş.", "Porsche 911 · İstanbul", "Klasik bir 911'i bu kadar özenle kiralayan başka yer bilmiyorum. Teslimde kısa bir sürüş eğitimi bile verdiler.", null),
        ("Defne Ç.", "Suzuki Samurai · Antalya", "Sahil yolları için birebir. Uygun fiyat, sıfır sürpriz ve çok eğlenceli.", null),
        ("Onur T.", "BMW 2 Serisi · İstanbul", "Hafta sonu kaçamağı için aldım; iade sürecinde provizyon aynı gün kalktı.", null),
    };
    var faqs = new (string Q, string A)[]
    {
        ("Araç kiralamak için neler gerekli?", "Geçerli sürücü belgesi, kimlik veya pasaport ve sürücü adına kredi kartı yeterli. Araca göre en az 21–30 yaş ve 2–8 yıllık ehliyet şartı aranır; şartlar her aracın sayfasında yazıyor."),
        ("Ödemeyi ne zaman yapıyorum?", "Online rezervasyonda kartınızdan çekim yapılmaz. Ödeme araç tesliminde kredi kartıyla alınır; aynı anda araç sınıfına göre provizyon bloke edilir ve iadeden sonra kaldırılır."),
        ("Rezervasyonumu iptal edebilir miyim?", "Evet. Onay e-postasındaki bağlantıdan ya da Rezervasyonum sayfasından teslim saatine kadar ücretsiz iptal edebilirsiniz."),
        ("Aracı farklı bir şubeye bırakabilir miyim?", "Evet. Aynı şehirdeki farklı şubeye iade 750 ₺, farklı şehre iade 2.500 ₺ tek yön ücretiyle mümkündür; fiyat rezervasyon özetinde hemen görünür."),
        ("Uzun süreli kiralamada indirim var mı?", "7 gün ve üzeri %10, 14 gün ve üzeri %15, 30 gün ve üzeri %20 indirim otomatik uygulanır. Daha uzun süreler için kurumsal teklif alabilirsiniz."),
        ("Kasko ve sigorta dahil mi?", "Tüm araçlarımızda kasko ve zorunlu trafik sigortası fiyata dahildir. Tam Koruma Paketi ile hasar muafiyetini sıfırlayabilirsiniz."),
    };
}

<section class="hero" data-hero>
    <div class="hero-media" aria-hidden="true">
        <img src="/images/banner-img.jpg" alt="" data-hero-img fetchpriority="high">
    </div>
    <div class="container hero-content">
        <p class="eyebrow eyebrow-light" data-hero-in><span class="dot"></span> 7 şube · 10 model · 7/24 teslim</p>
        <h1 class="hero-title" data-split>Yolculuğun, <em>senin</em> kurallarınla.</h1>
        <p class="hero-lead" data-hero-in>Havalimanında karşılama, kasko dahil şeffaf fiyatlar ve iki dakikada onaylanan rezervasyon. Sadece direksiyona geç.</p>
        <div class="hero-actions" data-hero-in>
            <a href="/filo" class="btn btn-accent btn-lg magnetic">Filoyu keşfet @Ui.Icon("arrow")</a>
            <a href="/kurumsal" class="btn btn-ghost btn-lg">Kurumsal kiralama</a>
        </div>
    </div>
    <div class="container hero-search" data-hero-in>
        <partial name="_SearchBar" model="Model.Trip" />
    </div>
    <div class="hero-scroll" aria-hidden="true"><span></span></div>
</section>

<section class="brands" aria-label="Filomuzdaki markalar">
    <div class="marquee">
        <div class="marquee-track">
            @for (var i = 0; i < 2; i++)
            {
                foreach (var b in new[] { "BMW", "Mercedes-Benz", "Porsche", "Ferrari", "Land Rover", "Ford", "Mercedes-AMG", "Suzuki" })
                {
                    <span>@b</span><span class="sep">✦</span>
                }
            }
        </div>
    </div>
</section>

<section class="section statement">
    <div class="container">
        <p class="statement-text" data-reveal-words>Araç kiralamak; uzun formlar, gizli ücretler ve kuyruklar demek olmamalı. GoCar'da fiyat ilk ekranda belli, araç teslimde tertemiz ve ekibimiz uçağınız rötar yapsa bile sizi bekliyor.</p>
        <div class="stats">
            <div class="stat" data-anim="fade-up"><strong data-count="@Model.Vehicles">@Model.Vehicles</strong><span>araçlık filo</span></div>
            <div class="stat" data-anim="fade-up"><strong data-count="@Catalog.Branches.Count">@Catalog.Branches.Count</strong><span>havalimanı ve şehir şubesi</span></div>
            <div class="stat" data-anim="fade-up"><strong data-count="@(12000 + Model.Rentals)" data-format="tr">@((12000 + Model.Rentals).ToString("N0", Catalog.Tr))</strong><span>tamamlanan kiralama</span></div>
            <div class="stat" data-anim="fade-up"><strong><span data-count="4.9" data-decimals="1">4,9</span><small>/5</small></strong><span>müşteri puanı</span></div>
        </div>
    </div>
</section>

<section class="fleet-rail" data-rail>
    <div class="container rail-head">
        <div>
            <p class="eyebrow">Filo</p>
            <h2 class="section-title" data-anim="fade-up">Her yolculuğa <em>bir</em> karakter.</h2>
        </div>
        <div class="rail-head-side">
            <p>Fiyatlar @Model.Trip.Days günlük örnek kiralama içindir; tarihleri seçince anında güncellenir.</p>
            <a href="/filo" class="btn btn-outline">Tüm filo @Ui.Icon("arrow")</a>
        </div>
    </div>
    <div class="rail-viewport">
        <div class="rail-track" data-rail-track>
            @foreach (var card in Model.Featured)
            {
                <partial name="_CarCard" model="card" view-data="ViewData" />
            }
            <a href="/filo" class="rail-more">
                <span>Tüm araçları<br>karşılaştır</span>
                @Ui.Icon("arrow-up-right")
            </a>
        </div>
    </div>
</section>

<section class="section categories">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">Kategoriler</p>
            <h2 class="section-title" data-anim="fade-up">Ne arıyorsun?</h2>
        </div>
        <div class="cat-grid">
            @foreach (var (name, img, text) in new[] {
                ("Sedan", "item-large5.jpg", "İş seyahati ve uzun yol konforu"),
                ("SUV", "item-large2.jpg", "Geniş aileler, büyük bagajlar"),
                ("Spor", "item-large9.jpg", "Özel günler, unutulmaz sürüşler"),
                ("Arazi", "item-large3.jpg", "Kamp, kayak ve keşif") })
            {
                <a href="/filo?tip=@name" class="cat-tile" data-anim="card">
                    <img src="/images/@img" alt="" loading="lazy">
                    <div class="cat-tile-text">
                        <h3>@name</h3>
                        <p>@text</p>
                    </div>
                    <span class="cat-tile-arrow">@Ui.Icon("arrow-up-right")</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="section steps-section">
    <div class="container steps-layout">
        <div class="steps-intro">
            <p class="eyebrow">Nasıl çalışır</p>
            <h2 class="section-title">Dört adımda <em>yoldasın.</em></h2>
            <p class="muted">Kayıt yok, ön ödeme yok. Rezervasyonun anında onaylanır; tüm ayrıntılar e-postana ve takvimine gelir.</p>
            <a href="/filo" class="btn btn-dark">Hemen başla @Ui.Icon("arrow")</a>
        </div>
        <ol class="steps" data-steps>
            <li class="step">
                <span class="step-num">01</span>
                <div><h3>Tarih ve şubeni seç</h3><p>7 şubeden birini seç; farklı şehirde bırakmak istersen tek yön ücretini hemen gör.</p></div>
            </li>
            <li class="step">
                <span class="step-num">02</span>
                <div><h3>Aracını ve ek hizmetleri belirle</h3><p>Müsait araçlar anlık listelenir. Tam koruma, ek sürücü, çocuk koltuğu… fiyat canlı güncellenir.</p></div>
            </li>
            <li class="step">
                <span class="step-num">03</span>
                <div><h3>Onay e-postanı al</h3><p>Rezervasyon kodu, takvim daveti ve "rezervasyonu yönet" bağlantısı saniyeler içinde gelir.</p></div>
            </li>
            <li class="step">
                <span class="step-num">04</span>
                <div><h3>Anahtarı teslim al</h3><p>Ehliyetin ve kredi kartınla şubeye gel; ödeme teslimde, provizyon iadede kalkar.</p></div>
            </li>
            <span class="steps-line" aria-hidden="true"><span data-steps-line></span></span>
        </ol>
    </div>
</section>

<section class="section why">
    <div class="container why-layout">
        <div class="why-media" data-clip-reveal>
            <img src="/images/item-large8.jpg" alt="Mercedes-AMG GT R" loading="lazy" data-parallax>
            <div class="why-badge">
                <strong>%100</strong>
                <span>kasko dahil fiyat</span>
            </div>
        </div>
        <div class="why-list">
            <p class="eyebrow">Neden GoCar</p>
            <h2 class="section-title" data-anim="fade-up">Küçük ayrıntılar, <em>büyük</em> fark.</h2>
            <div class="features">
                @foreach (var (icon, t, d) in new[] {
                    ("shield", "Kasko dahil, sürpriz yok", "Gördüğün fiyat KDV ve kasko dahil son fiyat."),
                    ("plane", "Havalimanında karşılama", "Uçuşunu takip ederiz; rötar olsa da bekleriz."),
                    ("calendar", "Teslime kadar ücretsiz iptal", "Planın mı değişti? Tek tıkla iptal et."),
                    ("sparkle", "Her kiralamada derin temizlik", "Araçlar her teslim öncesi 42 noktada kontrol edilir."),
                    ("headset", "7/24 yol yardım", "Lastik, akü, kaza… tek numara, her saat."),
                    ("card", "Ön ödeme yok", "Ödeme teslimde; provizyon iadede kalkar.") })
                {
                    <div class="feature" data-anim="fade-up">
                        <span class="feature-icon">@Ui.Icon(icon)</span>
                        <div><h3>@t</h3><p>@d</p></div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="section testimonials">
    <div class="container section-head center">
        <p class="eyebrow">Yorumlar</p>
        <h2 class="section-title" data-anim="fade-up">Direksiyondakiler <em>anlatıyor.</em></h2>
    </div>
    @for (var row = 0; row < 2; row++)
    {
        var items = row == 0 ? testimonials.Take(4) : testimonials.Skip(4);
        <div class="marquee marquee-cards @(row == 1 ? "marquee-reverse" : "")">
            <div class="marquee-track">
                @for (var i = 0; i < 2; i++)
                {
                    foreach (var t in items)
                    {
                        <figure class="quote" aria-hidden="@(i == 1 ? "true" : "false")">
                            <div class="stars">@for (var s = 0; s < 5; s++) { @Ui.Icon("star") }</div>
                            <blockquote>@t.Text</blockquote>
                            <figcaption>
                                @if (t.Img is not null)
                                {
                                    <img src="/images/@t.Img" alt="" loading="lazy">
                                }
                                else
                                {
                                    <span class="avatar">@t.Name[0]</span>
                                }
                                <span><strong>@t.Name</strong><small>@t.Meta</small></span>
                            </figcaption>
                        </figure>
                    }
                }
            </div>
        </div>
    }
</section>

<section class="section branches" id="subeler">
    <div class="container">
        <div class="section-head split">
            <div>
                <p class="eyebrow">Şubeler</p>
                <h2 class="section-title" data-anim="fade-up">Seni <em>indiğin yerde</em> karşılıyoruz.</h2>
            </div>
            <p class="muted">Havalimanı şubelerimiz 7/24 açık. Şehir şubelerinde 08:00–22:00 arası teslim alıp bırakabilirsin.</p>
        </div>
        <div class="branch-list">
            @foreach (var b in Catalog.Branches)
            {
                <a class="branch" href="/filo?sube=@b.Code&donusSube=@b.Code" data-anim="fade-up">
                    <span class="branch-city">@b.City</span>
                    <span class="branch-name">@Ui.Icon(b.IsAirport ? "plane" : "building") @b.Name</span>
                    <span class="branch-addr">@b.Address</span>
                    <span class="branch-hours">@Ui.Icon("clock") @b.Hours</span>
                    <span class="branch-go">@Ui.Icon("arrow")</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="section corporate-band">
    <div class="container corporate-inner" data-anim="fade-up">
        <div>
            <p class="eyebrow eyebrow-light">Kurumsal</p>
            <h2>Şirketin için <em>esnek</em> filo çözümleri.</h2>
            <p>Aylık sabit fiyat, bakım ve lastik dahil, ihtiyaç değiştikçe araç değişimi. 1 iş gününde teklif.</p>
        </div>
        <a href="/kurumsal" class="btn btn-accent btn-lg magnetic">Teklif al @Ui.Icon("arrow")</a>
    </div>
</section>

<section class="section faq" id="sss">
    <div class="container faq-layout">
        <div>
            <p class="eyebrow">SSS</p>
            <h2 class="section-title" data-anim="fade-up">Aklındaki <em>sorular.</em></h2>
            <p class="muted">Cevabı bulamadın mı? <a href="/iletisim" class="link">Bize yaz</a>, mesai saatlerinde 1 saat içinde dönüyoruz.</p>
        </div>
        <div class="accordion">
            @foreach (var (q, a) in faqs)
            {
                <details class="acc" data-anim="fade-up">
                    <summary>@q <span class="acc-icon">@Ui.Icon("plus")</span></summary>
                    <div class="acc-body"><p>@a</p></div>
                </details>
            }
        </div>
    </div>
</section>

@section Head {
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "AutoRental",
      "name": "GoCar Araç Kiralama",
      "telephone": "+90 850 000 00 00",
      "address": { "@@type": "PostalAddress", "streetAddress": "Büyükdere Cad. No: 185", "addressLocality": "İstanbul", "addressCountry": "TR" },
      "openingHours": "Mo-Su 00:00-23:59"
    }
    </script>
}
