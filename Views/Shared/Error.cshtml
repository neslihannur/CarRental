@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}
<section class="section page-top text-center">
    <div class="container narrow">
        <h2>Bir şeyler ters gitti</h2>
        <p>İsteğinizi şu an tamamlayamadık. Lütfen birazdan tekrar deneyin.</p>
        @if (Model.ShowRequestId)
        {
            <p><small>Talep no: <code>@Model.RequestId</code></small></p>
        }
        <a href="/" class="btn btn-primary mt-3">Ana sayfaya dön</a>
    </div>
</section>
