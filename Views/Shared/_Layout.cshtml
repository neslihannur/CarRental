<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] is string t ? t + " · " : "")GoCar Araç Kiralama</title>
    <meta name="description" content="GoCar ile sedan, SUV, spor ve arazi araçlarını birkaç adımda kiralayın. Havalimanı teslimi, şeffaf fiyat, 7/24 destek.">
    <meta name="theme-color" content="#94CA21">
    <link rel="icon" href="~/images/logo.png">

    <link rel="stylesheet" href="~/css/vendor.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9.4.1/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
</head>

<body data-bs-spy="scroll" data-bs-target="#header-nav" tabindex="0">

    <nav class="navbar navbar-expand-lg navbar-light container-fluid py-3 position-fixed" id="header-nav">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="~/images/logo.png" alt="GoCar"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar"
                    aria-controls="offcanvasNavbar" aria-label="Menüyü aç">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Menü</h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
                </div>
                <div class="offcanvas-body">
                    <ul class="navbar-nav align-items-center justify-content-end flex-grow-1 pe-3">
                        <li class="nav-item"><a class="nav-link px-3" href="/#filo">Filo</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="/#process">Nasıl Çalışır</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="/#pricing">Uzun Dönem</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="/#services">Hizmetler</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="/#faq">SSS</a></li>
                    </ul>
                    <div class="d-flex mt-4 mt-lg-0 ps-lg-3 justify-content-center">
                        <a class="btn btn-primary btn-nav" href="/#search">Araç Bul</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <section id="footer">
        <div class="container footer-container mt-5">
            <footer class="row my-5 py-5">
                <div class="col-md-5 mt-5 mt-md-0">
                    <img src="~/images/logo.png" alt="GoCar">
                    <p class="py-3 footer-text">
                        Sedan'dan arazi aracına geniş filo, havalimanı teslimi ve şeffaf fiyatlarla
                        yolculuğunuzu kolaylaştırıyoruz.
                    </p>
                    <div class="d-flex align-items-center gap-4">
                        <a href="#" aria-label="Instagram"><iconify-icon class="social-link-icon" icon="mdi:instagram"></iconify-icon></a>
                        <a href="#" aria-label="X"><iconify-icon class="social-link-icon" icon="ri:twitter-x-fill"></iconify-icon></a>
                        <a href="#" aria-label="LinkedIn"><iconify-icon class="social-link-icon" icon="mdi:linkedin"></iconify-icon></a>
                        <a href="#" aria-label="YouTube"><iconify-icon class="social-link-icon" icon="mdi:youtube"></iconify-icon></a>
                    </div>
                </div>
                <div class="col-6 col-md-3 offset-md-1 mt-5 mt-md-0">
                    <h6 class="footer-title">Keşfet</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/#filo">Filo</a></li>
                        <li><a href="/#process">Nasıl Çalışır</a></li>
                        <li><a href="/#pricing">Uzun Dönem Kiralama</a></li>
                        <li><a href="/#faq">Sıkça Sorulanlar</a></li>
                        <li><a href="/gizlilik">Gizlilik ve KVKK</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3 mt-5 mt-md-0">
                    <h6 class="footer-title">İletişim</h6>
                    <ul class="list-unstyled footer-links">
                        <li><iconify-icon icon="solar:phone-outline"></iconify-icon> 0850 000 00 00</li>
                        <li><iconify-icon icon="solar:letter-outline"></iconify-icon> merhaba@gocar.example</li>
                        <li><iconify-icon icon="solar:map-point-outline"></iconify-icon> Levent, İstanbul</li>
                        <li><iconify-icon icon="solar:clock-circle-outline"></iconify-icon> 7/24 açık</li>
                    </ul>
                </div>
            </footer>
        </div>

        <div class="border-top">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-4 footer-bottom">
                    <p class="mb-0">© @DateTime.Now.Year GoCar · Bu site bir portföy demo projesidir; rezervasyonlar gerçek değildir.</p>
                    <p class="mb-0">
                        Geliştiren <a href="https://portfolio.neslihannur.com.tr" target="_blank" rel="noopener">Neslihan Nur Han</a>
                        · Şablon <a href="https://templatesjungle.com/" class="website-link" target="_blank" rel="noopener">TemplatesJungle</a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <script src="~/js/jquery-1.11.0.min.js"></script>
    <script src="~/js/plugins.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@9.4.1/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
