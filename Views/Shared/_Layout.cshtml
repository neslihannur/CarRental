@{
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string ?? "GoCar ile premium araç kiralama: havalimanı ve şehir şubelerinden 7/24 teslim, şeffaf fiyatlar, ücretsiz iptal.";
    var dark = ViewData["DarkHeader"] is true;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string p) => path.StartsWith(p) ? "is-active" : "";
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(title is null ? "GoCar · Premium Araç Kiralama" : $"{title} · GoCar")</title>
    <meta name="description" content="@description">
    <meta name="theme-color" content="#0E1013">
    <meta property="og:type" content="website">
    <meta property="og:title" content="@(title ?? "GoCar · Premium Araç Kiralama")">
    <meta property="og:description" content="@description">
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/images/banner-img.jpg")">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230E1013'/%3E%3Ctext x='50%25' y='56%25' text-anchor='middle' dominant-baseline='middle' font-family='Arial' font-weight='800' font-size='34' fill='%23FFC21A'%3EG%3C/text%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(dark ? "has-dark-header" : "")">
    <partial name="_Icons" />
    <div class="scroll-progress" aria-hidden="true"></div>

    <header class="site-header @(dark ? "is-dark" : "")" data-header>
        <div class="container header-inner">
            <a href="/" class="logo" aria-label="GoCar ana sayfa">Go<span>Car</span></a>
            <nav class="nav" aria-label="Ana menü">
                <a href="/filo" class="@Active("/filo") @Active("/arac")">Filo</a>
                <a href="/kurumsal" class="@Active("/kurumsal")">Kurumsal</a>
                <a href="/#subeler">Şubeler</a>
                <a href="/kosullar" class="@Active("/kosullar")">Koşullar</a>
                <a href="/iletisim" class="@Active("/iletisim")">İletişim</a>
            </nav>
            <div class="header-actions">
                <a href="tel:08500000000" class="header-phone">@Ui.Icon("phone") 0850 000 00 00</a>
                <a href="/rezervasyonum" class="btn btn-sm btn-outline">Rezervasyonum</a>
                <button class="menu-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false" data-menu-toggle>@Ui.Icon("menu")</button>
            </div>
        </div>
    </header>

    <div class="mobile-menu" data-mobile-menu hidden>
        <nav>
            <a href="/filo">Filo</a>
            <a href="/kurumsal">Kurumsal</a>
            <a href="/#subeler">Şubeler</a>
            <a href="/kosullar">Koşullar</a>
            <a href="/iletisim">İletişim</a>
            <a href="/rezervasyonum">Rezervasyonum</a>
        </nav>
        <a href="tel:08500000000" class="btn btn-accent btn-lg">@Ui.Icon("phone") 0850 000 00 00</a>
    </div>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-cta" data-anim="fade-up">
                <h2>Yolculuğun bir tık <em>uzağında.</em></h2>
                <a href="/filo" class="btn btn-accent btn-lg magnetic">Aracını seç @Ui.Icon("arrow")</a>
            </div>
            <div class="footer-grid">
                <div>
                    <a href="/" class="logo logo-light">Go<span>Car</span></a>
                    <p class="footer-about">Türkiye'nin dört bir yanındaki havalimanı ve şehir şubelerimizden 7/24 premium araç kiralama.</p>
                    <div class="footer-badges">
                        <span>@Ui.Icon("shield") Kasko dahil</span>
                        <span>@Ui.Icon("headset") 7/24 destek</span>
                    </div>
                </div>
                <div>
                    <h4>Kirala</h4>
                    <a href="/filo">Tüm filo</a>
                    <a href="/filo?tip=Spor">Spor otomobiller</a>
                    <a href="/filo?tip=SUV">SUV</a>
                    <a href="/filo?tip=Arazi">Arazi araçları</a>
                    <a href="/kurumsal">Uzun dönem & kurumsal</a>
                </div>
                <div>
                    <h4>Yardım</h4>
                    <a href="/rezervasyonum">Rezervasyonumu yönet</a>
                    <a href="/kosullar">Kiralama koşulları</a>
                    <a href="/#sss">Sık sorulan sorular</a>
                    <a href="/gizlilik">Gizlilik ve KVKK</a>
                    <a href="/iletisim">İletişim</a>
                </div>
                <div>
                    <h4>İletişim</h4>
                    <a href="tel:08500000000">@Ui.Icon("phone") 0850 000 00 00</a>
                    <a href="mailto:merhaba@gocar.example">@Ui.Icon("mail") merhaba@gocar.example</a>
                    <span class="footer-text">@Ui.Icon("pin") Büyükdere Cad. No: 185, Levent / İstanbul</span>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.UtcNow.Year GoCar. Bu site bir <a href="https://portfolio.neslihannur.com.tr" target="_blank" rel="noopener">portföy demo projesidir</a>; rezervasyonlar gerçek değildir.</span>
                <span>Geliştiren <a href="https://portfolio.neslihannur.com.tr" target="_blank" rel="noopener">Neslihan Nur Han</a> · Görseller ve ilk şablon: <a href="https://templatesjungle.com/" target="_blank" rel="noopener">TemplatesJungle</a></span>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/tr.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
